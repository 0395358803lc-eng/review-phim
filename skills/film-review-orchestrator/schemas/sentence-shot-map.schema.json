{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narration-to-original-film evidence map",
  "type": "object",
  "required": ["source_movie_sha256", "source_duration_s", "narration_duration_s", "sentences"],
  "properties": {
    "source_movie_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "source_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "narration_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "sentences": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["sentence_id", "review_text", "voice_start_s", "voice_end_s", "atomic_claims", "chosen_shots", "unresolved_claims"],
      "properties": {
        "sentence_id": {"type": "string", "minLength": 1},
        "review_text": {"type": "string", "minLength": 1},
        "voice_start_s": {"type": "number", "minimum": 0},
        "voice_end_s": {"type": "number", "exclusiveMinimum": 0},
        "atomic_claims": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["claim_id", "text", "verdict", "evidence_ids"],
          "properties": {"claim_id": {"type": "string"}, "text": {"type": "string"}, "verdict": {"$ref": "#/$defs/verdict"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}
          }
        }},
        "unresolved_claims": {"type": "array", "items": {"type": "string"}},
        "chosen_shots": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["source_start_s", "source_end_s", "voice_start_s", "voice_end_s", "visual_evidence_ids", "asr_evidence_ids", "verdict", "qualifier"],
          "properties": {"source_start_s": {"type": "number", "minimum": 0}, "source_end_s": {"type": "number", "minimum": 0},
            "voice_start_s": {"type": "number", "minimum": 0}, "voice_end_s": {"type": "number", "minimum": 0},
            "visual_evidence_ids": {"type": "array", "items": {"type": "string"}}, "asr_evidence_ids": {"type": "array", "items": {"type": "string"}},
            "verdict": {"$ref": "#/$defs/verdict"}, "qualifier": {"type": "string"}
          }
        }}
      }
    }}
  },
  "$defs": {"verdict": {"enum": ["VISUAL_DIRECT", "DIALOGUE_SUPPORTED", "CONTEXT_ONLY", "UNRESOLVED", "CONTRADICTED"]}}
}
