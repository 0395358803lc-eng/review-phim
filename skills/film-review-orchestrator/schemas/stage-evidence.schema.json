{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage evidence for N00-N09",
  "type": "object",
  "required": ["stage", "outcome", "source_sha256", "reviewed_at_utc", "checks", "artifacts", "limitations"],
  "properties": {
    "stage": {"type": "string", "pattern": "^N0[0-9]$"},
    "outcome": {"enum": ["PASS", "WARN", "FAIL", "BLOCKED"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at_utc": {"type": "string", "minLength": 10},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["path", "sha256"], "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    }},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "tool_versions": {"type": "object"},
    "source_time_window_s": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
  }
}
